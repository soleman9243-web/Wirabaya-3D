  nodes:
  - speakerName: Wirabaya
    dialogueText: '"Nenek, dagingnya sudah selesai dimasak. Nenek harus makan agar
      cepat...'
    hasChoices: 0
    choices: []
    cameraType: 1
    cameraID: 
    endDialogueAfterThis: 0
    jumpToNode: 0
    nextNodeId: 0
  - speakerName: Nenek
    dialogueText: Uhuk! Uhuk! ...Napas nenek sesak, cu. Simpan saja dulu makanannya...
    hasChoices: 0
    choices: []
    cameraType: 0
    cameraID: 
    endDialogueAfterThis: 0
    jumpToNode: 0
    nextNodeId: 0
  - speakerName: Wirabaya
    dialogueText: Nenek! Badan Nenek semakin panas. Ini bukan sekadar masuk angin
      biasa seperti kata Nenek tadi pagi!
    hasChoices: 0
    choices: []
    cameraType: 1
    cameraID: 
    endDialogueAfterThis: 0
    jumpToNode: 0
    nextNodeId: 0
  - speakerName: Wirabaya
    dialogueText: Tahanlah sebentar, Nek. Aku ingat ada tumbuhan obat langka di dekat
      Gua Beruang. Aku akan kesana untuk mengambilnya!
    hasChoices: 0
    choices: []
    cameraType: 1
    cameraID: 
    endDialogueAfterThis: 1
